void setup() {
  Serial.begin(9600);

  // Set receiver pin for RF433
  mySwitch.enableReceive(D1); // Use GPIO D1
  
  // Set ultrasonic sensor pins
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
